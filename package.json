{
  "name": "thanaweya-amma-math-copilot",
  "private": true,
  "version": "1.0.0",
  "description": "تطبيق ويندوز لمساعد الرياضيات لطلاب الثانوية العامة (علمي رياضة)",
  "author": "Thanaweya Amma Educational Systems",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:all": "vite build && node scripts/build-electron.mjs",
    "package:win": "npm run build:all && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "verify-build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "start": "node server.ts",
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';['dist','dist-electron','release','server.js'].forEach(p=>rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:unit": "node --import tsx --test tests/unit/assessmentScoring.test.ts",
    "test": "npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.18.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@dyad-sh/react-vite-component-tagger": "^0.9.0"
  }
}
