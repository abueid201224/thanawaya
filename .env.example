# ==============================================================================
# Thanaweya Amma Math Copilot - Environment Configuration Template
# ==============================================================================
#
# IMPORTANT NOTES:
# 1. Variables starting with VITE_* are bundled into the client build (dist/assets).
#    For local Windows packaging or testing, create a file named `.env.production`
#    or `.env.local` with your actual values before running `npm run package:win`.
# 2. In GitHub Actions (.github/workflows/build-windows.yml), configure these values
#    in Settings -> Secrets and variables -> Actions repository secrets.
# 3. NEVER provide Supabase `service_role` keys in client-facing environments.
#    Only the public `anon` key is permitted.
# ==============================================================================

# --- Supabase Cloud Authentication & Database ---
# Must start with https:// and point to your Supabase project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase public Anon Key (RLS-enforced, safe for distribution)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# --- Gemini AI Configuration ---
# Optional server-side fallback. On Windows desktop, users configure their key
# securely through the settings modal (Ctrl+,) stored via Windows DPAPI (safeStorage).
GEMINI_API_KEY=""

# Gemini Model Selection Priority:
# User Settings (Modal) -> GEMINI_MODEL env -> Default (gemini-flash-latest)
# Valid regex pattern: ^[A-Za-z0-9._-]{3,80}$
GEMINI_MODEL="gemini-flash-latest"

# --- Embedded Application Host ---
# Host loopback URL for embedded Express server
APP_URL="http://127.0.0.1:47321"
