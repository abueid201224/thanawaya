<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ThanaweyaAmma.App</RootNamespace>
    <AssemblyName>ThanaweyaAmma.App</AssemblyName>
    <ApplicationTitle>ثانوية عامة - علمي رياضة | Thanaweya Amma Copilot</ApplicationTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Supabase & PostgREST / Realtime -->
    <PackageReference Include="supabase-csharp" Version="1.1.1" />
    <PackageReference Include="postgrest-csharp" Version="3.5.1" />
    
    <!-- Logging & Dependency Injection -->
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />

    <!-- UI & Modern WPF Controls -->
    <PackageReference Include="Wpf.Ui" Version="3.0.4" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    
    <!-- Media / Video Player Wrapper -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />

    <!-- JSON & Cryptography -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Views\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Services\" />
    <Folder Include="Helpers\" />
    <Folder Include="Data\" />
  </ItemGroup>

</Project>
