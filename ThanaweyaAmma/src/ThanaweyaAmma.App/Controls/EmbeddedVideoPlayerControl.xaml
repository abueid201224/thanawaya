<UserControl x:Class="ThanaweyaAmma.App.Controls.EmbeddedVideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#090D16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#111827" Padding="12,8" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtMediaTitle" 
                           Text="مشغل وسائط المنهج التعليمي (فيديو / صوت / روابط كشاف الوزارة)" 
                           Foreground="#F9FAFB" 
                           FontWeight="SemiBold" 
                           FontSize="14" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BtnSpeed" Content="1.0x" 
                            Click="BtnSpeed_Click" 
                            Background="#1F2937" Foreground="#E5E7EB" 
                            BorderBrush="#374151" Padding="8,4" FontSize="11" Cursor="Hand"/>
                    <Button x:Name="BtnOpenUrl" Content="فتح رابط..." 
                            Click="BtnOpenUrl_Click" 
                            Background="#2563EB" Foreground="White" 
                            BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Media Display Area -->
        <Border Grid.Row="1" Background="#000000" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="MediaPlayer" 
                              LoadedBehavior="Manual" 
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              MediaOpened="MediaPlayer_MediaOpened"
                              MediaEnded="MediaPlayer_MediaEnded"
                              MediaFailed="MediaPlayer_MediaFailed"/>

                <!-- Placeholder when idle -->
                <StackPanel x:Name="PnlPlaceholder" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Opacity="0.75" Visibility="Visible">
                    <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="مشغل المناهج المعتمدة - الثانوية العامة" 
                               Foreground="#9CA3AF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="اختر درساً من مكتبة المناهج أو شغل رابط فيديو مرصود بواسطة الكشاف الذكي" 
                               Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Controls Bar -->
        <Border Grid.Row="2" Background="#111827" Padding="14,10" BorderBrush="#1F2937" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek Slider -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCurrentTime" Text="00:00" Foreground="#9CA3AF" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider x:Name="SliderTimeline" Grid.Column="1" 
                            Minimum="0" Maximum="100" Value="0" 
                            ValueChanged="SliderTimeline_ValueChanged" 
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00" Foreground="#9CA3AF" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Control Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnPlayPause" Content="▶ تشغيل" 
                                Click="BtnPlayPause_Click" 
                                Background="#2563EB" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand"/>
                        <Button x:Name="BtnStop" Content="⏹ إيقاف" 
                                Click="BtnStop_Click" 
                                Background="#374151" Foreground="#E5E7EB" 
                                BorderThickness="0" Padding="10,6" FontSize="12" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Volume & Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🔊" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12"/>
                        <Slider x:Name="SliderVolume" Width="90" Minimum="0" Maximum="1" Value="0.8" 
                                ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
