<Application x:Class="ThanaweyaAmma.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Global Fluent Resources & Color Palette -->
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DarkCanvasBrush" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
